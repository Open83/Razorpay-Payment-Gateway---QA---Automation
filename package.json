{
  "name": "razorpay-qa-automation",
  "version": "0.1.0",
  "description": "QA automation portfolio project for Razorpay Payment Gateway integration testing using Playwright Test",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:ci": "playwright test --project=chromium --grep-invert @razorpay-live",
    "test:razorpay": "playwright test --project=chromium --grep @razorpay-live"
  },
  "keywords": [
    "qa",
    "automation",
    "playwright",
    "razorpay",
    "payment-gateway",
    "testing"
  ],
  "author": "tester@mysadaqahonline.com",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "razorpay": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
